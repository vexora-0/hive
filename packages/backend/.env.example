# ─── Server ──────────────────────────────────────────────────────────────
# Must match EXPO_PUBLIC_API_URL in apps/mobile/.env
PORT=4000

# Set to `production` on deploy. Controls error verbosity — in any other mode
# the error handler returns internal messages to the client.
NODE_ENV=development

# Public origin of this server. Used to build absolute URLs.
BACKEND_URL=http://localhost:4000

# ─── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# WARNING: the service-role key bypasses row level security entirely.
# Server-side only. Never expose it to the client or commit it.
SUPABASE_SERVICE_KEY=your-service-role-key

# Required by `pnpm verify:env` only — the server itself never uses it.
# Signing in as a demo account needs the anon key: the service-role key does
# not mint the user-scoped JWT the API expects, so without this there is no way
# to get a token for scripts/verify-security.sh.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ─── Admin seeding (pnpm seed:admin) ─────────────────────────────────────
# No defaults — the script exits if these are unset.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Hive Admin

# ─── Redis ───────────────────────────────────────────────────────────────
# Used only by the order idempotency middleware.
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Defaults to `*` if unset — always set this explicitly in production.
CORS_ORIGINS=http://localhost:8081

# ─── Demo seed (pnpm seed) ───────────────────────────────────────────────
# Required: seedDemo.ts exits if it is unset. It is the password given to every
# generated teacher and parent, so it is what you type to log in as them.
DEMO_PASSWORD=choose-a-demo-password

# Optional. Unset disables error reporting, which is what local dev wants.
SENTRY_DSN=

# Required by `pnpm seed:admin`. No default — the script exits if unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
