# Copy to .env.test and point at a SEPARATE Supabase project.
#
# This suite deletes every row in every domain table and deletes the auth users
# it creates. tests/setup.ts refuses to run if SUPABASE_URL contains the demo
# project ref, but that guard only knows about the one ref it was told about —
# do not rely on it to catch a second mistake.
#
# Set the test project up by creating a new Supabase project and running every
# migration in supabase/migrations against it.

NODE_ENV=test
PORT=4001

# The test project — NOT the demo project.
SUPABASE_URL=https://your-test-project.supabase.co

# Service-role key. Bypasses RLS by design; never let this reach a client.
SUPABASE_SERVICE_KEY=your-test-service-role-key

REDIS_URL=redis://localhost:6379

BACKEND_URL=http://localhost:4001

CORS_ORIGINS=http://localhost:8081
