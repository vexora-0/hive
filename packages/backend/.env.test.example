# Test environment for `pnpm test` (Plan 08).
#
# MUST point at a SEPARATE Supabase project from development and demo. The test
# harness truncates tables between runs — pointing this at the demo project
# wipes the data you are about to present.
#
# tests/setup.ts refuses to run if SUPABASE_URL matches the value in .env.

# ─── Server ──────────────────────────────────────────────────────────────
# Must match EXPO_PUBLIC_API_URL in apps/mobile/.env
PORT=4000

# Set to `production` on deploy. Controls error verbosity — in any other mode
# the error handler returns internal messages to the client.
NODE_ENV=test

# Public origin of this server. Used to build absolute URLs.
BACKEND_URL=http://localhost:4000

# ─── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# WARNING: the service-role key bypasses row level security entirely.
# Server-side only. Never expose it to the client or commit it.
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Test accounts ───────────────────────────────────────────────────────
# Created and destroyed by the harness.
# No defaults — the script exits if these are unset.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Hive Admin

# ─── Redis ───────────────────────────────────────────────────────────────
# Used only by the order idempotency middleware.
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Defaults to `*` if unset — always set this explicitly in production.
CORS_ORIGINS=http://localhost:8081

# Password used for every generated test user.
DEMO_PASSWORD=test-only-password
