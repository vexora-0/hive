# EXPO_PUBLIC_* variables are inlined into the bundle at build time and are
# visible to anyone with the app. Never put a secret here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The anon key is public by design — row level security enforces access.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Must match PORT in packages/backend/.env.
# On a physical device this cannot be localhost — use your machine's LAN IP
# (e.g. http://192.168.1.5:4000) or a tunnel URL.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional. Unset disables error reporting. Inlined at build time like every
# EXPO_PUBLIC_* value, so set it before `eas build`, not after.
EXPO_PUBLIC_SENTRY_DSN=
